{
  "uid": "vmhub-fleet",
  "title": "Vacuum fleet",
  "tags": ["vmhub"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Battery",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vmhub_battery_pct",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Cleaning efficiency",
      "description": "Square metres per minute. A sustained decline is the early signal of a tangled brush or a loaded filter.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "none" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vmhub_efficiency_m2_per_min",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Consumables remaining",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "options": { "displayMode": "gradient", "orientation": "horizontal" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 15 },
              { "color": "green", "value": 30 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vmhub_consumable_remaining_pct",
          "legendFormat": "{{model}} / {{part}}",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Active faults",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "none", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vmhub_fault",
          "legendFormat": "{{model}} / {{code}} ({{vendor_code}})"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Sessions per day, by how they ended",
      "description": "A rising share of sessions ending anywhere other than docked means the robot is giving up more often. Note that a mid-run recharge closes a session (ADR-0002).",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 17 },
      "fieldConfig": {
        "defaults": { "unit": "none", "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(vmhub_sessions_total[1d])",
          "legendFormat": "{{model}} / {{ended_in}}"
        }
      ]
    }
  ]
}
