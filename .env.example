# Home Assistant. Create a long-lived access token under your HA profile → Security.
HA_WS_URL=ws://homeassistant.local:8123/api/websocket
HA_TOKEN=

# InfluxDB. INFLUX_TOKEN bootstraps the container and authenticates vmhub against it.
INFLUX_TOKEN=
INFLUX_USERNAME=vmhub
INFLUX_PASSWORD=
INFLUX_ORG=vmhub
INFLUX_BUCKET=vacuum

GRAFANA_PASSWORD=admin
LOG_LEVEL=INFO
